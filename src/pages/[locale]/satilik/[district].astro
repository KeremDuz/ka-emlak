---
import ListingsView from '../../../components/public/views/ListingsView.astro';
import { districtExists } from '../../../components/public/views/district-lookup';
import { routeLocale } from '../../../i18n/config';
const locale = routeLocale(Astro.params.locale);
if (!locale || !(await districtExists(Astro.locals, 'sale', Astro.params.district))) return Astro.rewrite('/404');
---
<ListingsView locale={locale} kind="sale" district={Astro.params.district}/>
