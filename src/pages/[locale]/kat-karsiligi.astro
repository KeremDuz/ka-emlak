---
import OwnerPageView from '../../components/public/views/OwnerPageView.astro';
import { routeLocale } from '../../i18n/config';
// Yalnız /en ve /fa geçerlidir; öteki ekler (/tr, /xx) 404 sayfasına gider.
const locale = routeLocale(Astro.params.locale);
if (!locale) return Astro.rewrite('/404');
---
<OwnerPageView locale={locale} kind="kat"/>
