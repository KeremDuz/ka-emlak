---
import InvestmentView from '../../components/public/views/InvestmentView.astro';
import { routeLocale } from '../../i18n/config';
// Yalnız Türkçe dışındaki diller (/en, /de, /ru, /ar, /fa) geçerlidir; öteki ekler (/tr, /xx) 404 sayfasına gider.
const locale = routeLocale(Astro.params.locale);
if (!locale) return Astro.rewrite('/404');
---
<InvestmentView locale={locale}/>
