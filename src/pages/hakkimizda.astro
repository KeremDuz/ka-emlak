---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getPublicData } from '../lib/server/data';
import { phoneLabel, whatsappUrl } from '../lib/format';
import { MessageCircle, Phone } from 'lucide-react';
const { settings, mode } = await getPublicData(Astro.locals);
---
<SiteLayout title="Hakkımızda" description="KA EMLAK, İshak Kahraman danışmanlığında Antalya’da konut, villa, arsa ve iş yeri alım, satım ve kiralama işlerine bakar." settings={settings} mode={mode}>
  <section class="page-intro"><div class="container"><h1>Hakkımızda</h1></div></section>
  <section class="container advisor-home" aria-labelledby="advisor-heading">
    <img class="advisor-photo" src="/images/advisor-portrait.webp" alt="" width="452" height="640"/>
    <div class="advisor-copy">
      <h2 id="advisor-heading">{settings.advisor}</h2>
      <p class="advisor-role">KA EMLAK gayrimenkul danışmanı</p>
      {settings.about && <p class="advisor-text">{settings.about}</p>}
      <p class="advisor-text">Konyaaltı’ndaki ofisimizden Antalya genelinde konut, iş yeri ve arsa alım, satım ve kiralama işlerine bakıyoruz.</p>
      {settings.licenseNumber && <p class="about-license">Taşınmaz Ticareti Yetki Belgesi No: {settings.licenseNumber}</p>}
      <div class="advisor-actions">
        {settings.phone && <a class="button" href={`tel:${settings.phone}`}><Phone size={17}/>{phoneLabel(settings.phone)}</a>}
        <a class="button outline" href={whatsappUrl(settings.whatsapp)} target="_blank" rel="noreferrer"><MessageCircle size={17}/>WhatsApp’tan yazın</a>
        <a class="button outline" href="/ilanlar">İlanları görün</a>
      </div>
    </div>
  </section>
</SiteLayout>
