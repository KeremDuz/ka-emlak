---
import SiteLayout from '../layouts/SiteLayout.astro';
import InquiryForm from '../components/public/InquiryForm';
import { getPublicData } from '../lib/server/data';
import { MapPin, Phone, MessageCircle, Mail, ArrowUpRight } from 'lucide-react';
import { whatsappUrl } from '../lib/format';
const {settings,mode}=await getPublicData(Astro.locals);
const kind=Astro.url.searchParams.get('talep')==='valuation'?'valuation':'callback';
---
<SiteLayout title="İletişim" settings={settings} mode={mode}><section class="page-intro page-intro-compact"><div class="container"><h1>İletişim</h1></div></section><section class="container content-page contact-layout"><div class="contact-info"><h2>{settings.advisor}</h2><div class="contact-method"><MapPin size={21}/><div><strong>Ofis</strong><p>{settings.address||'Konyaaltı / Antalya'}</p><a href="https://www.google.com/maps/search/?api=1&query=KA+Emlak+Konyaalt%C4%B1+Antalya" target="_blank" rel="noreferrer">Yol tarifi <ArrowUpRight size={12} style={{display:'inline'}}/></a></div></div>{settings.phone&&<div class="contact-method"><Phone size={20}/><div><strong>Telefon</strong><a href={`tel:${settings.phone}`}>{settings.phone}</a></div></div>}<div class="contact-method"><MessageCircle size={21}/><div><strong>WhatsApp</strong><a href={whatsappUrl(settings.whatsapp)} target="_blank" rel="noreferrer">Mesaj gönderin <ArrowUpRight size={12} style={{display:'inline'}}/></a></div></div>{settings.email&&<div class="contact-method"><Mail size={21}/><div><strong>E-posta</strong><a href={`mailto:${settings.email}`}>{settings.email}</a></div></div>}{settings.hours&&<div class="contact-method"><div><strong>Çalışma saatleri</strong><p>{settings.hours}</p></div></div>}</div><InquiryForm kind={kind} client:load/></section></SiteLayout>
