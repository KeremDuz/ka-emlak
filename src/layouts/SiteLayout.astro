---
import '../styles/global.css';
import { ArrowUpRight, Menu, Phone, MapPin, X, MessageCircle } from 'lucide-react';
import { whatsappUrl } from '../lib/format';
import { officeSettings } from '../lib/seed';
import type { OfficeSettings } from '../lib/types';
interface Props { title?:string; description?:string; settings?:OfficeSettings; mode?:'live'|'preview'; image?:string; noindex?:boolean; whatsappMessage?:string; }
const { title='Antalya satılık ve kiralık gayrimenkul', description='KA EMLAK ile Antalya, Konyaaltı, Döşemealtı ve çevresindeki satılık ve kiralık gayrimenkulleri keşfedin. İshak Kahraman ile doğrudan iletişime geçin.',settings=officeSettings,mode='live',image='/images/og-default.png',noindex=false,whatsappMessage }=Astro.props;
const path=Astro.url.pathname;
const canonical=new URL(path,Astro.site||Astro.url.origin).href;
const navigation=[['/','Ana sayfa'],['/ilanlar','İlanlar'],['/hakkimizda','Hakkımızda'],['/iletisim','İletişim']];
---
<!doctype html><html lang="tr"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/><meta name="theme-color" content="#123d34"/><title>{title} | KA EMLAK</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta property="og:type" content="website"/><meta property="og:title" content={`${title} | KA EMLAK`}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:locale" content="tr_TR"/><meta property="og:image" content={new URL(image,Astro.url.origin).href}/><meta name="twitter:card" content="summary_large_image"/>{(noindex||mode==='preview')&&<meta name="robots" content="noindex,nofollow"/>}<link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/></head><body><a href="#main" class="skip-link">İçeriğe geç</a>{mode==='preview'&&<div class="preview-note">Yerel önizleme · İlan bilgileri yayın öncesi ofis tarafından kontrol edilecektir.<a href="/yonetim">Yönetim paneli</a></div>}<header class="container site-header"><a class="brand" href="/" aria-label="KA EMLAK ana sayfa"><svg class="brand-symbol" viewBox="0 0 45 52" fill="none" aria-hidden="true"><path d="M3 24 22.5 4 42 24M10 20v27h25V20M18 47V32h9v15" stroke="currentColor" stroke-width="1.8" stroke-linecap="square"/><path d="M15 15 22.5 7 30 15M4 51h37" stroke="#b89562" stroke-width="1.5"/></svg><span><span class="brand-name">KA EMLAK</span><span class="brand-sub">GAYRİMENKUL DANIŞMANLIĞI</span></span></a><nav class="nav" id="main-navigation" aria-label="Ana menü">{navigation.map(([href,label])=><a href={href} class={path===href?'active':''} aria-current={path===href?'page':undefined}>{label}</a>)}</nav><a class="header-contact" href={settings.phone?`tel:${settings.phone}`:'/iletisim'}><Phone size={14}/><span>{settings.phone?settings.phone.replace(/^\+90(\d{3})(\d{3})(\d{2})(\d{2})$/,'0$1 $2 $3 $4'):'İletişim'}</span></a><button class="mobile-menu-toggle" id="menu-toggle" aria-expanded="false" aria-controls="main-navigation" aria-label="Menüyü aç"><Menu size={23}/></button></header><main id="main"><slot/></main><footer class="site-footer"><div class="container"><div class="footer-grid"><div><a class="brand" href="/"><span><span class="brand-name">KA EMLAK<span style="color:var(--bronze)">.</span></span><span class="brand-sub">GAYRİMENKUL DANIŞMANLIĞI</span></span></a></div><div class="footer-column"><strong>İlanlar</strong><a href="/ilanlar?transaction=sale">Satılık</a><a href="/ilanlar?transaction=rent">Kiralık</a><a href="/ilanlar?transaction=exchange">Kat karşılığı</a></div><div class="footer-column"><strong>KA EMLAK</strong><a href="/hakkimizda">Hakkımızda</a><a href="/iletisim?talep=valuation">Mülk değerleme</a><a href="/iletisim">İletişim</a><a href="https://www.hepsiemlak.com/emlak-ofisi/ka-emlak-29750" target="_blank" rel="noreferrer">Hepsiemlak <ArrowUpRight size={10} style={{display:'inline'}}/></a></div><div class="footer-column"><strong>İletişim</strong><p>{settings.address||'Konyaaltı / Antalya'}</p>{settings.phone&&<a href={`tel:${settings.phone}`}>{settings.phone.replace('+90','+90 ')}</a>}<a href={whatsappUrl(settings.whatsapp)} target="_blank" rel="noreferrer">WhatsApp <ArrowUpRight size={10} style={{display:'inline'}}/></a>{settings.email&&<a href={`mailto:${settings.email}`}>{settings.email}</a>}</div></div><div class="footer-bottom"><span>© {new Date().getFullYear()} KA EMLAK. Tüm hakları saklıdır.</span><div><a href="/gizlilik">Gizlilik ve aydınlatma</a><a href="/cerezler">Çerez tercihleri</a><a href="/yonetim">Yönetici girişi</a></div></div></div></footer><div class="mobile-contact-bar"><a href={settings.phone?`tel:${settings.phone}`:'/iletisim'}><Phone size={15}/>Ara</a><a href={whatsappUrl(settings.whatsapp,whatsappMessage)} target="_blank" rel="noreferrer"><MessageCircle size={16}/>WhatsApp</a></div><script>const menu=document.getElementById('menu-toggle');menu?.addEventListener('click',()=>{const open=menu.getAttribute('aria-expanded')==='true';menu.setAttribute('aria-expanded',String(!open));menu.setAttribute('aria-label',open?'Menüyü aç':'Menüyü kapat');document.getElementById('main-navigation')?.classList.toggle('open',!open);});</script></body></html>
