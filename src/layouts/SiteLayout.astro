---
import '../styles/global.css';
import { ArrowUpRight, Check, ChevronDown, Globe, Menu, Phone, MessageCircle } from 'lucide-react';
import Consent from '../components/public/Consent';
import { legal } from '../content/legal';
import { validMeasurementId } from '../lib/analytics';
import { phoneLabel, whatsappUrl } from '../lib/format';
import { directionsUrl, officeLinks } from '../lib/office-links';
import { officeSettings } from '../lib/seed';
import type { Locale, OfficeSettings } from '../lib/types';
import { alternates, dictionary, direction, fill, localeNames, localePath, locales, ogLocales, splitLocale } from '../i18n';
interface Props { title?: string; description?: string; settings?: OfficeSettings; mode?: 'live' | 'preview'; image?: string; noindex?: boolean; whatsappMessage?: string; locale?: Locale; listing?: { id: string; transaction?: string; propertyType?: string }; }
const { locale = 'tr', settings = officeSettings, mode = 'live', image = '/images/og-default.png', noindex = false, listing } = Astro.props;
const t = dictionary(locale);
const { title = t.site.defaultTitle, description = t.site.defaultDescription, whatsappMessage = t.whatsapp.general } = Astro.props;
const origin = Astro.site || Astro.url.origin;
// path: adresin dil ekinden arınmış hali; menü seçimi, dil değiştirici ve hreflang bununla kurulur.
const { path } = splitLocale(Astro.url.pathname);
const canonical = new URL(localePath(locale, path), origin).href;
// Bulunamayan sayfa için dil karşılıkları yayımlanmaz.
const alternateLinks = noindex ? [] : alternates(path, origin);
const here = (target: Locale) => localePath(target, path) + Astro.url.search;
const href = (to: string) => localePath(locale, to);
const navigation = [['/', t.nav.home], ['/ilanlar', t.nav.listings], ['/donemlik-kiralik', t.nav.seasonal], ['/hakkimizda', t.nav.about], ['/kariyer', t.nav.career], ['/iletisim', t.nav.contact]];
// İlan sayfalarında da "İlanlar" menüsü seçili görünür.
const current = (to: string) => to === '/' ? path === '/' : path === to || path.startsWith(to === '/ilanlar' ? '/ilan' : `${to}/`);
const phoneHref = settings.phone ? `tel:${settings.phone}` : href('/iletisim');
// Farsça (Vazirmatn) ve Arapça (Noto Naskh Arabic + Noto Sans Arabic) yazı tipleri yalnız o dilin sayfalarında yüklenir.
// Lora ve Manrope Kiril harflerini de içerir; Rusça için ek yazı tipi gerekmez.
const scriptFonts: Partial<Record<Locale, string>> = { fa: '&family=Vazirmatn:wght@400..800', ar: '&family=Noto+Naskh+Arabic:wght@400..700&family=Noto+Sans+Arabic:wght@400..800' };
const fonts = `https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..600;1,400&family=Manrope:wght@400..800${scriptFonts[locale] ?? ''}&display=swap`;
// Ölçüm kodu ve Search Console doğrulaması derleme sırasında PUBLIC_ değişkenlerinden gelir; boşsa hiçbir şey eklenmez.
const gaId = validMeasurementId(import.meta.env.PUBLIC_GA_MEASUREMENT_ID);
const siteVerification = (import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION || '').trim();
const consentText = legal[locale].cookies.banner;
const analyticsConfig = JSON.stringify({ id: gaId, locale, listing });
const phoneText = settings.phone ? phoneLabel(settings.phone) : '';
const instagram = settings.instagram || officeSettings.instagram;
---
<!doctype html>
<html lang={locale} dir={direction(locale)}>
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <meta name="theme-color" content="#123d34"/>
  <title>{title} | KA EMLAK</title>
  <meta name="description" content={description}/>
  <link rel="canonical" href={canonical}/>
  {alternateLinks.map(link => <link rel="alternate" hreflang={link.locale} href={link.href}/>)}
  <meta property="og:type" content="website"/>
  <meta property="og:site_name" content="KA EMLAK"/>
  <meta property="og:title" content={`${title} | KA EMLAK`}/>
  <meta property="og:description" content={description}/>
  <meta property="og:url" content={canonical}/>
  <meta property="og:locale" content={ogLocales[locale]}/>
  {!noindex && locales.filter(other => other !== locale).map(other => <meta property="og:locale:alternate" content={ogLocales[other]}/>)}
  <meta property="og:image" content={new URL(image, Astro.url.origin).href}/>
  <meta name="twitter:card" content="summary_large_image"/>
  {(noindex || mode === 'preview') && <meta name="robots" content="noindex,nofollow"/>}
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png"/>
  <link rel="icon" href="/favicon.png" sizes="64x64" type="image/png"/>
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link rel="stylesheet" href={fonts}/>
  {siteVerification && <meta name="google-site-verification" content={siteVerification}/>}
  <slot name="head"/>
</head>
<body data-listing-id={listing?.id}>
  <a href="#main" class="skip-link">{t.site.skip}</a>
  {mode === 'preview' && <div class="preview-note">{t.site.previewNote}<a href="/yonetim">{t.site.adminPanel}</a></div>}
  <div class="site-header-wrap" id="site-header">
    <header class="container site-header">
      <a class="brand" href={href('/')} aria-label={t.site.homeAria}>
        <img class="brand-symbol" src="/images/logo-mark.webp" width="96" height="96" alt="" aria-hidden="true" fetchpriority="high"/>
        <span><span class="brand-name" dir="ltr">KA EMLAK</span><span class="brand-sub">{t.site.brandSub}</span></span>
      </a>
      <nav class="nav" id="main-navigation" aria-label={t.site.mainMenu}>
        {navigation.map(([to, label]) => <a href={href(to)} class={current(to) ? 'active' : ''} aria-current={path === to ? 'page' : undefined}>{label}</a>)}
        <div class="lang-switch lang-switch-menu" role="group" aria-label={t.site.language}>
          {locales.map(other => <a href={here(other)} lang={other} hreflang={other} class={other === locale ? 'active' : ''} aria-current={other === locale ? 'true' : undefined}>{localeNames[other]}</a>)}
        </div>
      </nav>
      {/* Dil seçimi masaüstünde açılır menüdür; telefonda diller menünün içinde listelenir. */}
      <details class="lang-picker lang-switch-bar" id="lang-picker">
        <summary aria-label={t.site.language}><Globe size={17} aria-hidden="true"/><span>{locale.toUpperCase()}</span><ChevronDown size={15} aria-hidden="true"/></summary>
        <div class="lang-switch lang-picker-menu" role="group" aria-label={t.site.language}>
          {locales.map(other => <a href={here(other)} lang={other} hreflang={other} class={other === locale ? 'active' : ''} aria-current={other === locale ? 'true' : undefined}><span>{localeNames[other]}</span>{other === locale && <Check size={16} aria-hidden="true"/>}</a>)}
        </div>
      </details>
      <a class="header-contact" href={phoneHref} aria-label={settings.phone ? fill(t.site.callAria, { phone: phoneText }) : t.site.contact}><Phone size={17}/><span dir="ltr">{settings.phone ? phoneText : t.site.contact}</span></a>
      <button class="mobile-menu-toggle" id="menu-toggle" aria-expanded="false" aria-controls="main-navigation" aria-label={t.site.menuOpen} data-open-label={t.site.menuOpen} data-close-label={t.site.menuClose}><Menu size={24}/></button>
    </header>
  </div>
  <main id="main"><slot/></main>
  <footer class="site-footer">
    <div class="container">
      <div class="footer-grid">
        <div><a class="brand" href={href('/')} aria-label={t.site.homeAria}><img class="brand-symbol" src="/images/logo-mark.webp" width="96" height="96" alt="" aria-hidden="true" loading="lazy"/><span><span class="brand-name" dir="ltr">KA EMLAK</span><span class="brand-sub">{t.site.brandSub}</span></span></a></div>
        <div class="footer-column"><strong>{t.footer.listings}</strong><a href={href('/satilik')}>{t.footer.sale}</a><a href={href('/kiralik')}>{t.footer.rent}</a><a href={href('/donemlik-kiralik')}>{t.footer.seasonal}</a><a href={href('/ilanlar?transaction=exchange')}>{t.footer.exchange}</a><a href={href('/ilanlar?gorunum=harita')}>{t.footer.map}</a><a href={href('/yatirim')}>{t.footer.investment}</a></div>
        <div class="footer-column"><strong>KA EMLAK</strong><a href={href('/hakkimizda')}>{t.footer.about}</a><a href={href('/kat-karsiligi')}>{t.footer.katKarsiligi}</a><a href={href('/kentsel-donusum')}>{t.footer.renewal}</a><a href={href('/arsa-degerleme')}>{t.footer.landValuation}</a><a href={href('/kariyer')}>{t.footer.career}</a><a href={href('/iletisim')}>{t.footer.contact}</a><a href={officeLinks.sahibinden} target="_blank" rel="noreferrer">sahibinden.com <ArrowUpRight size={14}/></a><a href={officeLinks.hepsiemlak} target="_blank" rel="noreferrer">hepsiemlak <ArrowUpRight size={14}/></a><a href={officeLinks.emlakjet} target="_blank" rel="noreferrer">emlakjet <ArrowUpRight size={14}/></a></div>
        <div class="footer-column"><strong>{t.footer.contactHeading}</strong><p>{settings.address || t.site.defaultAddress}</p><a href={directionsUrl} target="_blank" rel="noreferrer">{t.pages.contact.directions} <ArrowUpRight size={14}/></a>{settings.phone && <a href={`tel:${settings.phone}`} dir="ltr" class="footer-phone">{phoneText}</a>}<a href={whatsappUrl(settings.whatsapp, whatsappMessage)} target="_blank" rel="noreferrer">WhatsApp <ArrowUpRight size={14}/></a><a href={officeLinks.whatsappChannel} target="_blank" rel="noreferrer">{t.pages.contact.whatsappChannel} <ArrowUpRight size={14}/></a>{instagram && <a href={instagram} target="_blank" rel="noreferrer">Instagram <ArrowUpRight size={14}/></a>}<a href={officeLinks.facebook} target="_blank" rel="noreferrer">Facebook <ArrowUpRight size={14}/></a>{settings.email && <a href={`mailto:${settings.email}`}>{settings.email}</a>}</div>
      </div>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} KA EMLAK</span><div><a href={href('/gizlilik')}>{t.footer.privacy}</a><a href={href('/kvkk')}>{t.footer.kvkk}</a><a href={href('/cerezler')} data-consent-open={gaId ? '' : undefined}>{t.footer.cookies}</a><a href="/yonetim">{t.footer.admin}</a></div></div>
    </div>
  </footer>
  <div class="mobile-contact-bar"><a href={phoneHref}><Phone size={18}/>{t.site.call}</a><a href={whatsappUrl(settings.whatsapp, whatsappMessage)} target="_blank" rel="noreferrer"><MessageCircle size={18}/>WhatsApp</a></div>
  {/* Analytics yokken çerez onayı istenecek bir şey yoktur; afiş yalnız ölçüm kimliği varsa çıkar. */}
  {gaId && <Consent banner={consentText} title={t.consent.title} privacyHref={href('/gizlilik')} privacyLabel={t.consent.learnMore} client:idle/>}
  <script type="application/json" id="ka-analytics" set:html={analyticsConfig}/>
  <script>
    import { initAnalytics } from '../lib/analytics';
    try { initAnalytics(JSON.parse(document.getElementById('ka-analytics')?.textContent || '{}')); } catch { /* ölçüm yok */ }
    const menu = document.getElementById('menu-toggle');
    const navigation = document.getElementById('main-navigation');
    const setMenu = (open: boolean) => { menu?.setAttribute('aria-expanded', String(open)); menu?.setAttribute('aria-label', (open ? menu.dataset.closeLabel : menu.dataset.openLabel) ?? ''); navigation?.classList.toggle('open', open); };
    menu?.addEventListener('click', () => setMenu(menu.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', event => { if (event.key === 'Escape' && menu?.getAttribute('aria-expanded') === 'true') { setMenu(false); menu.focus(); } });
    // Dil menüsü dışarı tıklanınca ya da Esc ile kapanır.
    const picker = document.getElementById('lang-picker') as HTMLDetailsElement | null;
    document.addEventListener('click', event => { if (picker?.open && !picker.contains(event.target as Node)) picker.open = false; });
    document.addEventListener('keydown', event => { if (event.key === 'Escape' && picker?.open) { picker.open = false; picker.querySelector('summary')?.focus(); } });
    // Sayfa kaydırılınca üst menünün altına ince bir çizgi gelir.
    const header = document.getElementById('site-header');
    const mark = () => header?.classList.toggle('scrolled', window.scrollY > 8);
    mark(); window.addEventListener('scroll', mark, { passive: true });
  </script>
</body>
</html>
