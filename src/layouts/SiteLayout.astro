---
import '../styles/global.css';
import { ArrowUpRight, Menu, Phone, MessageCircle } from 'lucide-react';
import { phoneLabel, whatsappUrl } from '../lib/format';
import { officeSettings } from '../lib/seed';
import type { OfficeSettings } from '../lib/types';
interface Props { title?: string; description?: string; settings?: OfficeSettings; mode?: 'live' | 'preview'; image?: string; noindex?: boolean; whatsappMessage?: string; }
const { title = 'Antalya satılık ve kiralık gayrimenkul', description = 'KA EMLAK ile Antalya, Konyaaltı, Döşemealtı ve çevresindeki satılık ve kiralık gayrimenkulleri keşfedin. İshak Kahraman ile doğrudan iletişime geçin.', settings = officeSettings, mode = 'live', image = '/images/og-default.png', noindex = false, whatsappMessage } = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site || Astro.url.origin).href;
const navigation = [['/', 'Ana sayfa'], ['/ilanlar', 'İlanlar'], ['/hakkimizda', 'Hakkımızda'], ['/iletisim', 'İletişim']];
// İlan sayfalarında da "İlanlar" menüsü seçili görünür.
const current = (href: string) => href === '/' ? path === '/' : path === href || path.startsWith(href === '/ilanlar' ? '/ilan' : `${href}/`);
const phoneHref = settings.phone ? `tel:${settings.phone}` : '/iletisim';
---
<!doctype html>
<html lang="tr">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <meta name="theme-color" content="#123d34"/>
  <title>{title} | KA EMLAK</title>
  <meta name="description" content={description}/>
  <link rel="canonical" href={canonical}/>
  <meta property="og:type" content="website"/>
  <meta property="og:site_name" content="KA EMLAK"/>
  <meta property="og:title" content={`${title} | KA EMLAK`}/>
  <meta property="og:description" content={description}/>
  <meta property="og:url" content={canonical}/>
  <meta property="og:locale" content="tr_TR"/>
  <meta property="og:image" content={new URL(image, Astro.url.origin).href}/>
  <meta name="twitter:card" content="summary_large_image"/>
  {(noindex || mode === 'preview') && <meta name="robots" content="noindex,nofollow"/>}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..600;1,400&family=Manrope:wght@400..800&display=swap"/>
</head>
<body>
  <a href="#main" class="skip-link">İçeriğe geç</a>
  {mode === 'preview' && <div class="preview-note">Yerel önizleme. İlan bilgileri yayın öncesi ofis tarafından kontrol edilecektir.<a href="/yonetim">Yönetim paneli</a></div>}
  <div class="site-header-wrap" id="site-header">
    <header class="container site-header">
      <a class="brand" href="/" aria-label="KA EMLAK ana sayfa">
        <svg class="brand-symbol" viewBox="0 0 45 52" fill="none" aria-hidden="true"><path d="M3 24 22.5 4 42 24M10 20v27h25V20M18 47V32h9v15" stroke="currentColor" stroke-width="1.8" stroke-linecap="square"/><path d="M15 15 22.5 7 30 15M4 51h37" stroke="#b89562" stroke-width="1.5"/></svg>
        <span><span class="brand-name">KA EMLAK</span><span class="brand-sub">Gayrimenkul danışmanlığı</span></span>
      </a>
      <nav class="nav" id="main-navigation" aria-label="Ana menü">
        {navigation.map(([href, label]) => <a href={href} class={current(href) ? 'active' : ''} aria-current={path === href ? 'page' : undefined}>{label}</a>)}
      </nav>
      <a class="header-contact" href={phoneHref} aria-label={settings.phone ? `Ara: ${phoneLabel(settings.phone)}` : 'İletişim'}><Phone size={17}/><span>{settings.phone ? phoneLabel(settings.phone) : 'İletişim'}</span></a>
      <button class="mobile-menu-toggle" id="menu-toggle" aria-expanded="false" aria-controls="main-navigation" aria-label="Menüyü aç"><Menu size={24}/></button>
    </header>
  </div>
  <main id="main"><slot/></main>
  <footer class="site-footer">
    <div class="container">
      <div class="footer-grid">
        <div><a class="brand" href="/" aria-label="KA EMLAK ana sayfa"><span><span class="brand-name">KA EMLAK</span><span class="brand-sub">Gayrimenkul danışmanlığı</span></span></a></div>
        <div class="footer-column"><strong>İlanlar</strong><a href="/ilanlar?transaction=sale">Satılık</a><a href="/ilanlar?transaction=rent">Kiralık</a><a href="/ilanlar?transaction=exchange">Kat karşılığı</a><a href="/ilanlar?gorunum=harita">Haritada ilanlar</a></div>
        <div class="footer-column"><strong>KA EMLAK</strong><a href="/hakkimizda">Hakkımızda</a><a href="/iletisim?talep=valuation">Mülk değerleme</a><a href="/iletisim">İletişim</a><a href="https://www.hepsiemlak.com/emlak-ofisi/ka-emlak-29750" target="_blank" rel="noreferrer">Hepsiemlak sayfamız <ArrowUpRight size={14}/></a></div>
        <div class="footer-column"><strong>İletişim</strong><p>{settings.address || 'Konyaaltı / Antalya'}</p>{settings.phone && <a href={`tel:${settings.phone}`}>{phoneLabel(settings.phone)}</a>}<a href={whatsappUrl(settings.whatsapp)} target="_blank" rel="noreferrer">WhatsApp <ArrowUpRight size={14}/></a>{settings.email && <a href={`mailto:${settings.email}`}>{settings.email}</a>}</div>
      </div>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} KA EMLAK</span><div><a href="/gizlilik">Gizlilik ve aydınlatma</a><a href="/cerezler">Çerez tercihleri</a><a href="/yonetim">Yönetici girişi</a></div></div>
    </div>
  </footer>
  <div class="mobile-contact-bar"><a href={phoneHref}><Phone size={18}/>Ara</a><a href={whatsappUrl(settings.whatsapp, whatsappMessage)} target="_blank" rel="noreferrer"><MessageCircle size={18}/>WhatsApp</a></div>
  <script>
    const menu = document.getElementById('menu-toggle');
    const navigation = document.getElementById('main-navigation');
    const setMenu = (open: boolean) => { menu?.setAttribute('aria-expanded', String(open)); menu?.setAttribute('aria-label', open ? 'Menüyü kapat' : 'Menüyü aç'); navigation?.classList.toggle('open', open); };
    menu?.addEventListener('click', () => setMenu(menu.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', event => { if (event.key === 'Escape' && menu?.getAttribute('aria-expanded') === 'true') { setMenu(false); menu.focus(); } });
    // Sayfa kaydırılınca üst menünün altına ince bir çizgi gelir.
    const header = document.getElementById('site-header');
    const mark = () => header?.classList.toggle('scrolled', window.scrollY > 8);
    mark(); window.addEventListener('scroll', mark, { passive: true });
  </script>
</body>
</html>
