---
import InstagramIcon from '../InstagramIcon.astro';
import { officeSettings } from '../../../lib/seed';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import InquiryForm from '../InquiryForm';
import { getPublicData } from '../../../lib/server/data';
import { dictionary } from '../../../i18n';
import type { Locale } from '../../../lib/types';
import { ArrowUpRight, Clock, Globe, Mail, MapPin, MessageCircle, Phone, Users } from 'lucide-react';
import { phoneLabel, whatsappUrl } from '../../../lib/format';
import { directionsUrl, officeLinks, officeMapEmbed } from '../../../lib/office-links';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = dictionary(locale);
const { settings, mode } = await getPublicData(Astro.locals);
const instagram = settings.instagram || officeSettings.instagram;
const instagramHandle = instagram.split('/').filter(Boolean).pop();
const kind = Astro.url.searchParams.get('talep') === 'valuation' ? 'valuation' : 'callback';
---
<SiteLayout locale={locale} title={t.pages.contact.title} description={t.pages.contact.description} settings={settings} mode={mode}>
  <section class="page-intro"><div class="container"><h1>{t.pages.contact.h1}</h1></div></section>
  <section class="container content-page contact-layout">
    <div class="contact-info">
      <h2>{settings.advisor}</h2>
      <p class="advisor-role">{t.advisor.role}</p>
      <ul class="contact-methods">
        {settings.phone && <li class="contact-method"><Phone size={22} aria-hidden="true"/><div><strong>{t.pages.contact.phone}</strong><a href={`tel:${settings.phone}`} dir="ltr" class="contact-phone">{phoneLabel(settings.phone)}</a></div></li>}
        <li class="contact-method"><MessageCircle size={22} aria-hidden="true"/><div><strong>WhatsApp</strong><a href={whatsappUrl(settings.whatsapp, t.whatsapp.general)} target="_blank" rel="noreferrer">{t.pages.contact.whatsappSend} <ArrowUpRight size={16} aria-hidden="true"/></a></div></li>
        <li class="contact-method"><MapPin size={22} aria-hidden="true"/><div><strong>{t.pages.contact.office}</strong><p>{settings.address || t.site.defaultAddress}</p><a class="minor" href={directionsUrl} target="_blank" rel="noreferrer">{t.pages.contact.directions} <ArrowUpRight size={15} aria-hidden="true"/></a><a class="minor" href={officeLinks.maps} target="_blank" rel="noreferrer">{t.pages.contact.viewOnMaps} <ArrowUpRight size={15} aria-hidden="true"/></a></div></li>
        <li class="contact-method"><Users size={22} aria-hidden="true"/><div><strong>{t.pages.contact.follow}</strong><a href={officeLinks.whatsappChannel} target="_blank" rel="noreferrer">{t.pages.contact.whatsappChannel} <ArrowUpRight size={16} aria-hidden="true"/></a><a href={officeLinks.whatsappGroup} target="_blank" rel="noreferrer">{t.pages.contact.whatsappGroup} <ArrowUpRight size={16} aria-hidden="true"/></a><a href={officeLinks.facebook} target="_blank" rel="noreferrer">Facebook <ArrowUpRight size={16} aria-hidden="true"/></a></div></li>
        {instagram && <li class="contact-method"><InstagramIcon size={22}/><div><strong>Instagram</strong><a href={instagram} target="_blank" rel="noreferrer" dir="ltr">@{instagramHandle} <ArrowUpRight size={16} aria-hidden="true"/></a></div></li>}
        {settings.email && <li class="contact-method"><Mail size={22} aria-hidden="true"/><div><strong>{t.pages.contact.email}</strong><a href={`mailto:${settings.email}`} dir="ltr" class="contact-phone">{settings.email}</a></div></li>}
        <li class="contact-method"><Globe size={22} aria-hidden="true"/><div><strong>{t.pages.contact.portals}</strong><a href={officeLinks.sahibinden} target="_blank" rel="noreferrer">sahibinden.com <ArrowUpRight size={16} aria-hidden="true"/></a><a href={officeLinks.hepsiemlak} target="_blank" rel="noreferrer">hepsiemlak <ArrowUpRight size={16} aria-hidden="true"/></a><a href={officeLinks.emlakjet} target="_blank" rel="noreferrer">emlakjet <ArrowUpRight size={16} aria-hidden="true"/></a></div></li>
        {settings.hours && <li class="contact-method"><Clock size={22} aria-hidden="true"/><div><strong>{t.pages.contact.hours}</strong><p>{settings.hours}</p></div></li>}
      </ul>
      <div class="office-map"><iframe src={officeMapEmbed} title={t.pages.contact.mapTitle} loading="lazy" referrerpolicy="no-referrer"></iframe></div>
    </div>
    <InquiryForm kind={kind} heading="h2" locale={locale} t={t.form} client:load/>
  </section>
</SiteLayout>
