---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import Catalog from '../Catalog';
import { getPublicData, publicPageSize } from '../../../lib/server/data';
import { filterListings } from '../../../lib/server/filters';
import { catalogOptions } from '../../../lib/listing-helpers';
import { dictionary } from '../../../i18n';
import type { Locale } from '../../../lib/types';
// İlanlar sayfası (kind="all") ve Dönemlik kiralık sayfası (kind="seasonal"): ikincisi sabit bir filtreyle aynı listeyi gösterir.
interface Props { locale: Locale; kind?: 'all' | 'seasonal'; }
const { locale, kind = 'all' } = Astro.props;
const t = dictionary(locale);
// Panelde "Kiralık" + kiralama dönemi "Günlük" ya da "Haftalık" seçilen ilan kendiliğinden dönemlik sayfasında görünür.
const fixed = kind === 'seasonal' ? { transaction: 'rent', period: 'short' } : {};
const data = await getPublicData(Astro.locals);
const filters = Object.fromEntries(Astro.url.searchParams);
const filtered = filterListings(data.listings, { ...filters, ...fixed });
const options = catalogOptions(filterListings(data.listings, fixed));
---
{kind === 'seasonal'
  ? <SiteLayout locale={locale} title={t.pages.seasonal.title} description={t.pages.seasonal.description} settings={data.settings} mode={data.mode}>
      <section class="page-intro"><div class="container"><h1>{t.pages.seasonal.h1}</h1><p>{t.pages.seasonal.intro}</p></div></section>
      <Catalog initialListings={filtered.slice(0, publicPageSize)} initialTotal={filtered.length} initialFilters={filters} options={options} available={data.available} fixed={fixed} locale={locale} t={t.catalog} card={t.card} mapText={t.map} client:load/>
    </SiteLayout>
  : <SiteLayout locale={locale} title={t.pages.listings.title} description={t.pages.listings.description} settings={data.settings} mode={data.mode}>
      <section class="page-intro page-intro-compact"><div class="container"><h1>{t.pages.listings.h1}</h1></div></section>
      <Catalog initialListings={filtered.slice(0, publicPageSize)} initialTotal={filtered.length} initialFilters={filters} options={options} available={data.available} locale={locale} t={t.catalog} card={t.card} mapText={t.map} client:load/>
    </SiteLayout>}
