---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import LandForm from '../LandForm';
import { getPublicData } from '../../../lib/server/data';
import { arsaFormu } from '../../../content/arsa-formu';
import { antalyaDistricts } from '../../../lib/listing-helpers';
import { dictionary, localePath } from '../../../i18n';
import type { Locale } from '../../../lib/types';
// Ücretsiz arsa değerleme: başlık ve açıklama src/content/arsa-formu.ts'ten; başvuru türü formda seçilir.
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = dictionary(locale);
const form = arsaFormu[locale];
const { settings, mode } = await getPublicData(Astro.locals);
---
<SiteLayout locale={locale} title={form.title} description={form.intro} settings={settings} mode={mode}>
  <section class="page-intro"><div class="container"><h1>{form.title}</h1><p>{form.intro}</p></div></section>
  <section class="section cream-section land-section" aria-label={t.pages.owner.formTitleAria}>
    <div class="container land-wrap">
      <LandForm locale={locale} content={form} officeOptions={arsaFormu.tr.options} districts={antalyaDistricts} initialType="degerleme" privacyHref={localePath(locale, '/gizlilik')} honeypotLabel={t.form.honeypot} client:load/>
    </div>
  </section>
</SiteLayout>
