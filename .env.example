# Sunucu değerleri. Gerçek sırları bu dosyaya veya Git'e yazmayın.
# Yerel: .env dosyasına kopyalayın. Üretim: Cloudflare Worker secrets/settings.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Panel girişi Supabase Auth ile yapılır (e-posta + şifre); ayrı bir giriş hizmeti yoktur.
# Supabase > Authentication > Users içinde açılmış tek yöneticinin User UID değeri.
ADMIN_UID=

# Supabase Free 1 GB fotoğraf alanı. %80 uyarı, %90 yeni yükleme durdurulur.
STORAGE_LIMIT_BYTES=1000000000
# Hesabın tamamındaki Supabase fotoğraf kullanımını yönetirken bu bucket'ı ayırın.

# Yerel örnek içerik yalnız DEV + localhost + bağlı veritabanı yokken açılır.
# Yerelde de örnek içerik istemiyorsanız off yazın; üretimde her durumda kapalıdır.
DEV_PREVIEW=auto
SITE_URL=http://localhost:4321

# İsteğe bağlı otomatik çeviri (İngilizce, Farsça). Üçü de doluysa yayınlanan ilan çevrilir; boşsa site Türkçe çalışır.
# Üretimde Cloudflare Worker secret olarak girilir. Gerçek anahtarı buraya yazmayın.
# TRANSLATE_API_URL OpenAI uyumlu "chat/completions" adresinin tamamıdır.
TRANSLATE_API_URL=
TRANSLATE_API_KEY=
TRANSLATE_MODEL=

# Herkese açık (sır değil); derleme anında gömülür. Boşsa Analytics ve doğrulama etiketi eklenmez.
PUBLIC_GA_MEASUREMENT_ID=
PUBLIC_GOOGLE_SITE_VERIFICATION=
